{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "data": {
  "name": "dataset"
 },
 "params": [
  {
   "name": "filtro_prueba",
   "value": "HSE Academia Juvenil|HSE"
  }
 ],
 "transform": [
  {
   "calculate": "split(filtro_prueba, '|')[0]",
   "as": "_fp"
  },
  {
   "calculate": "split(filtro_prueba, '|')[1]",
   "as": "_fa"
  },
  {
   "filter": "datum.Prueba == datum._fp && datum.Area == datum._fa"
  },
  {
   "calculate": "2 * PI * (datum.idx - 1) / datum.N",
   "as": "theta"
  },
  {
   "calculate": "170 + 105 * (datum.Pct_Estudiante/100) * sin(datum.theta)",
   "as": "x_est"
  },
  {
   "calculate": "215 + 105 * (datum.Pct_Estudiante/100) * cos(datum.theta)",
   "as": "y_est"
  },
  {
   "calculate": "170 + 105 * (datum.Pct_Aula/100) * sin(datum.theta)",
   "as": "x_aula"
  },
  {
   "calculate": "215 + 105 * (datum.Pct_Aula/100) * cos(datum.theta)",
   "as": "y_aula"
  },
  {
   "calculate": "170 + 139 * sin(datum.theta)",
   "as": "x_lbl"
  },
  {
   "calculate": "215 + 139 * cos(datum.theta)",
   "as": "y_lbl"
  },
  {
   "calculate": "170 + 105 * sin(datum.theta)",
   "as": "x_rad"
  },
  {
   "calculate": "215 + 105 * cos(datum.theta)",
   "as": "y_rad"
  },
  {
   "calculate": "format(datum.Pct_Estudiante, '.0f') + '%'",
   "as": "pct_txt"
  }
 ],
