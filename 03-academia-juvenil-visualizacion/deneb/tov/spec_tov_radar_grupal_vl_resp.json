     "filter": "isValid(datum.valor)"
    },
    {
     "aggregate": [
      {
       "op": "mean",
       "field": "valor",
       "as": "promedio"
      },
      {
       "op": "valid",
       "field": "valor",
       "as": "n"
      }
     ],
     "groupby": [
      "area",
      "orden"
     ]
    },
    {
     "calculate": "-PI/2 + 2*PI*(datum.orden-1)/12",
     "as": "ang"
    },
    {
     "calculate": "datum.promedio * cos(datum.ang)",
     "as": "x"
    },
    {
     "calculate": "datum.promedio * sin(datum.ang)",
     "as": "y"
    },
    {
     "calculate": "datum.promedio == 0 ? 'Sin datos' : datum.promedio <= 1.80 ? 'Desacuerdo marcado' : datum.promedio <= 2.60 ? 'Desacuerdo' : datum.promedio <= 3.40 ? 'Posición intermedia' : datum.promedio <= 4.20 ? 'Acuerdo' : 'Acuerdo marcado'",
