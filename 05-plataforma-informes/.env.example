# ── Plataforma de informes AJ 2026: configuración por variables de entorno ──
# Copia este archivo a .env y coloca tus valores. EL .env REAL NUNCA SE VERSIONA.

# Base de datos institucional (solo lectura)
DB_HOST=tu-servidor.ejemplo.com
DB_PORT=5432
DB_NAME=nombre_de_la_base
DB_USER=usuario_lectura
DB_PASSWORD=coloca_aqui_tu_clave

# Rutas y enlaces (opcionales; por defecto se resuelven solas)
# AJ_WEB=/ruta/a/la/carpeta/web
# AJ_INFORMES=/ruta/a/la/carpeta/de/informes
# AJ_FUENTE=/ruta/a/datos_integrados.json
# AJ_TPL=/ruta/a/la/plantilla.pdf
# AJ_FONTS=/ruta/a/las/fuentes
# AJ_CPIE=/ruta/a/cp_ie_por_clave.json
# AJ_TOV_JSON=/ruta/a/dashboard_tov_resultados.json
# AJ_CONFIG=/ruta/a/config/evaluaciones.json
# AJ_URL=https://mi-plataforma.ejemplo.com
